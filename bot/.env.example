# Discord bot token — Developer Portal → Bot → Token
DISCORD_BOT_TOKEN=your_bot_token

# Application ID — Developer Portal → General Information
DISCORD_CLIENT_ID=your_application_id

# Optional: register commands to one server instantly (dev). Omit for global registration.
DISCORD_GUILD_ID=your_server_id

# SQLite database (default for local dev)
DATABASE_URL="file:./dev.db"
