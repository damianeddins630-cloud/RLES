# Discord OAuth (website login)
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
SESSION_SECRET=your_random_session_secret

# Discord bot (slash commands on Vercel)
DISCORD_BOT_TOKEN=your_bot_token
DISCORD_PUBLIC_KEY=your_discord_public_key

# Optional: register commands to one guild instantly (dev)
# DISCORD_GUILD_ID=your_server_id

# Database — Neon Postgres (use pooled Prisma URL on Vercel)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Optional: Neon also provides POSTGRES_PRISMA_URL — copy that value into DATABASE_URL

# Optional OAuth redirect override
# DISCORD_REDIRECT_URI=https://your-app.vercel.app/api/auth/callback

# Vercel Blob (optional)
leaguemastersystem_STORE_ID=your_store_id
leaguemastersystem_READ_WRITE_TOKEN=your_blob_read_write_token
